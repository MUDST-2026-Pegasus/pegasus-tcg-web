
# origin ของ backend — เบราว์เซอร์ยิงตรง ต้องอยู่ใน CORS_ALLOWED_ORIGINS ของ pegasus-tcg-api
# ปล่อยว่าง: pnpm dev ใช้ http://localhost:8080, production build ใช้ origin เดียวกับหน้าเว็บ (/api)
VITE_API_BASE_URL=http://localhost:8080

# บัญชีร้าน Pegasus ที่แถว Pegasus Picks ในหน้าแรกดึงสินค้ามา (ค่าเริ่มต้น pegasus_official)
VITE_PEGASUS_STORE_USERNAME=

# Grafana Faro collector URL. Leave empty to disable frontend telemetry.
VITE_FARO_URL=
# Usually injected by CI; VITE_APP_VERSION can be set to a git SHA.
VITE_APP_VERSION=
VITE_APP_ENV=

# Tolgee (แปลภาษา) — ใช้เฉพาะ pnpm dev: ดึงคำแปลสดและ Alt+คลิกแก้คำแปลบนหน้าเว็บ
# ใส่ค่าจริงใน .env.development.local เท่านั้น (ไม่ใช่ .env — Vite โหลด .env ตอน build production ด้วย)
# production ไม่ใช้ค่านี้ — เว็บใช้ JSON ใน src/i18n ที่ pnpm i18n:pull มา
VITE_APP_TOLGEE_API_URL=
VITE_APP_TOLGEE_API_KEY=
