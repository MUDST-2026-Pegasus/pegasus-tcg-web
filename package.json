  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "i18n:extract-check": "tolgee extract check",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:compare": "tolgee compare",
    "i18n:sync": "tolgee sync",
    "i18n:pull": "tolgee pull",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"src/test/integration/**\" --outputFile.junit=test-results/unit.xml",
    "test:integration": "vitest run src/test/integration --outputFile.junit=test-results/integration.xml",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --passWithNoTests",
    "test:e2e": "cypress run",
    "test:e2e:promotions": "cypress run --spec src/test/cypress/e2e/promotions-ledger.cy.ts --env runPromotions=true",
    "test:e2e:auction": "bash scripts/test-auction-e2e.sh",
    "cyopen": "cypress open",
    "cyrun": "cypress run"
  },
